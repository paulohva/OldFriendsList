<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<!-- one friend in the list: status dot, name (class colour), "Level 60 Warrior - Zone" -->
	<Button name="OldFriendsListRowTemplate" virtual="true">
		<Size x="290" y="34"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Selected" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<Color r="0.25" g="0.45" b="0.85" a="0.35"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Status">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="4" y="-3"/>
					</Anchors>
				</Texture>
				<FontString parentKey="Name" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="TOPLEFT" x="24" y="-4"/>
						<Anchor point="TOPRIGHT" x="-24" y="-4"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Info" inherits="GameFontHighlightSmall" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Name" relativePoint="BOTTOMLEFT" y="-3"/>
						<Anchor point="TOPRIGHT" relativeKey="$parent.Name" relativePoint="BOTTOMRIGHT" y="-3"/>
					</Anchors>
				</FontString>
				<Texture parentKey="NoteIcon" hidden="true" file="Interface\Buttons\UI-GuildButton-PublicNote-Up">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="RIGHT" x="-6" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD"/>
	</Button>
</Ui>
